#!/usr/bin/env bash
set -euo pipefail

die() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

confirm() {
    local reply
    while true; do
        read -r -n 1 -p "$1" reply || {
            printf '\n'
            exit 0
        }
        printf '\n'
        case "$reply" in
        [yY]) return 0 ;;
        [nN] | '') return 1 ;;
        *) printf 'Please answer y or n.\n' ;;
        esac
    done
}

default_branch() {
    local head name
    head="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"

    for name in "${head#origin/}" main master; do
        [[ -n "$name" ]] || continue
        if git show-ref --verify --quiet "refs/heads/$name"; then
            printf '%s\n' "$name"
            return
        fi
    done

    return 1
}

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "Run inside a Git repository."

default="${1:-}"
if [[ -z "$default" ]]; then
    default="$(default_branch)" || die "Could not work out the default branch. Pass it as an argument."
fi
git show-ref --verify --quiet "refs/heads/$default" || die "No local branch called '$default'."

mapfile -t refs < <(git for-each-ref --sort=-committerdate --format='%(refname)' refs/heads)

branches=()
for ref in "${refs[@]}"; do
    branch="${ref#refs/heads/}"
    [[ "$branch" == "$default" ]] || branches+=("$branch")
done

((${#branches[@]})) || {
    printf 'Nothing but %s here.\n' "$default"
    exit 0
}

current="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
printf '%d branches to go through (%s excluded)\n' "${#branches[@]}" "$default"

for branch in "${branches[@]}"; do
    IFS=$'\t' read -r sha when subject < <(
        git log -1 --date=format:'%Y-%m-%d %H:%M' --format='%h%x09%cd%x09%s' "refs/heads/$branch"
    )

    state='not merged'
    if git merge-base --is-ancestor "refs/heads/$branch" "refs/heads/$default"; then
        state=merged
    fi

    printf '\n%s  %s  %s  [%s]\n' "$sha" "$when" "$branch" "$state"
    printf '  %s\n' "$subject"

    confirm "Delete '$branch'? [y/N] " || continue

    if [[ "$branch" == "$current" ]]; then
        printf 'Switching to %s first.\n' "$default"
        git switch --quiet "$default" || {
            printf "Could not switch, leaving '%s' alone.\n" "$branch" >&2
            continue
        }
        current=$default
    fi

    git branch -D -- "$branch" ||
        printf "Could not delete '%s' (checked out in another worktree?).\n" "$branch" >&2
done
