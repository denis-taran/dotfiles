#!/bin/bash
# recreate the local kind cluster for a clean slate
set -euo pipefail

name="${1:-kind}"
export KIND_EXPERIMENTAL_PROVIDER="${KIND_EXPERIMENTAL_PROVIDER:-podman}"

kind delete cluster --name "$name"

if grep -qi microsoft /proc/version; then
    export NETAVARK_FW=iptables
    sudo update-alternatives --set iptables /usr/sbin/iptables-legacy
    sudo update-alternatives --set ip6tables /usr/sbin/ip6tables-legacy
    if [ "$(podman network inspect kind --format '{{.IPv6Enabled}}' 2>/dev/null)" = "true" ]; then
        podman network rm kind
    fi
    podman network exists kind || podman network create --ipv6=false kind
fi

kind create cluster --name "$name"
kubectl cluster-info --context "kind-$name"
